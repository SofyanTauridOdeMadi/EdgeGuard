#!/bin/sh /etc/rc.common
# ╔══════════════════════════════════════════════════════════════════════╗
# ║  EDGE GUARD — OpenWrt init.d (autostart 4 daemon)                    ║
# ║                                                                       ║
# ║    pemantau_trafik.py   — SNI sniffer + AI klasifikasi               ║
# ║    kuota_tracker.py     — tracker bandwidth → menit aktif            ║
# ║    reward_sistem.py     — penjadwalan cerdas edu → bonus hiburan     ║
# ║                                                                       ║
# ║  (heartbeat berjalan sebagai thread di dalam pemantau_trafik.py)     ║
# ║                                                                       ║
# ║  Pakai:                                                               ║
# ║    /etc/init.d/edgeguard {start|stop|restart|status|enable|disable}  ║
# ╚══════════════════════════════════════════════════════════════════════╝

START=99
STOP=10
USE_PROCD=1

BASE='/root/edgeguard/sistem_router'
LOG_DIR='/tmp'
ENV_FILE='/etc/edgeguard.env'

start_service() {
  # Load env
  [ -f "$ENV_FILE" ] && . "$ENV_FILE"

  # Init firewall ipset (idempoten)
  sh "$BASE/aturan_firewall.sh" init >/dev/null 2>&1

  # Init captive portal: IP alias + uhttpd egportal + nft DNAT (idempoten).
  # Sinkhole domain blacklist disinkronkan oleh pemantau_trafik.py (thread).
  sh "$BASE/captive_portal.sh" init >/dev/null 2>&1

  # ── pemantau_trafik.py ──────────────────────────────────────────────
  procd_open_instance pemantau
  procd_set_param command python3 "$BASE/pemantau_trafik.py" --with-dns --interface "${EG_IFACE:-br-lan}"
  procd_set_param env EG_CLOUD_URL="${EG_CLOUD_URL:-https://edgeguard.my.id}" \
                      EG_IFACE="${EG_IFACE:-br-lan}" \
                      EG_KUOTA_INTERVAL="${EG_KUOTA_INTERVAL:-20}" \
                      EG_KBPS_AKTIF="${EG_KBPS_AKTIF:-10}" \
                      EG_LIGHT="${EG_LIGHT:-0}" \
                      EG_DEBUG="${EG_DEBUG:-0}"
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_set_param respawn 5 10 5
  procd_set_param file "$BASE/pemantau_trafik.py"
  procd_close_instance

  # ── kuota_tracker.py & reward_sistem.py ─────────────────────────────
  # P4: kini dijalankan sebagai THREAD di dalam pemantau_trafik.py
  # (konsolidasi proses → hemat 2 interpreter Python). Tidak ada instance terpisah.
}

stop_service() {
  # Hentikan TERTARGET semua proses EdgeGuard (pemantau+portal) & capture child
  # (tcpdump/tshark) secara paksa agar 'stop' tuntas cepat — cegah restart
  # menggantung walau procd dalam keadaan tak konsisten. BUKAN "killall python3".
  kill -9 $(pgrep -f '/edgeguard/sistem_router/') 2>/dev/null
  killall -9 tcpdump tshark 2>/dev/null
  sh "$BASE/aturan_firewall.sh" flush >/dev/null 2>&1
}

reload_service() {
  stop
  start
}
